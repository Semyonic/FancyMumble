<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS code-signing entitlements (hardened runtime). -->
<plist version="1.0">
<dict>
  <!-- Voice input via CoreAudio (cpal). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>  <!-- signal-bridge.dylib is loaded at runtime with dlopen and is only
       ad-hoc signed, so library validation must be relaxed. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
